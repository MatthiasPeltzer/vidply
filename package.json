{
  "name": "vidply",
  "version": "1.0.42",
  "description": "Universal, accessible video & audio player with ES6 modules",
  "type": "module",
  "main": "dist/prod/vidply.esm.min.js",
  "module": "dist/prod/vidply.esm.min.js",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "npx serve . -p 3000",
    "start": "npm run clean && npm run build:js && npm run build:css && npm run dev",
    "build": "npm run clean && npm run build:js && npm run build:css",
    "build:js": "node build/build.js",
    "build:css": "node build/build-css.js",
    "watch": "node build/watch.js",
    "clean": "node build/clean.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:all": "vitest run && playwright test"
  },
  "keywords": [
    "video",
    "player",
    "audio",
    "accessible",
    "wcag",
    "a11y",
    "html5",
    "youtube",
    "vimeo",
    "hls",
    "captions",
    "subtitles",
    "vanilla",
    "es6",
    "javascript"
  ],
  "author": "Matthias Peltzer",
  "license": "GPL-2.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MatthiasPeltzer/vidply.git"
  },
  "bugs": {
    "url": "https://github.com/MatthiasPeltzer/vidply/issues",
    "email": "vidply@mpeltzer.de"
  },
  "homepage": "https://matthiaspeltzer.github.io/vidply/",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@vitest/coverage-v8": "^4.1.1",
    "clean-css": "^5.3.3",
    "esbuild": "^0.27.4",
    "jsdom": "^29.0.1",
    "terser": "^5.46.1",
    "vitest": "^4.1.1"
  }
}
