{
  "name": "vidply",
  "version": "1.1.5",
  "description": "Universal, accessible video & audio player authored in strict TypeScript. Ships ES modules with type declarations, supports HTML5, YouTube, Vimeo, SoundCloud, HLS (hls.js + native iOS) and MPEG-DASH.",
  "type": "module",
  "main": "dist/prod/vidply.esm.min.js",
  "module": "dist/prod/vidply.esm.min.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "npx serve . -p 3000",
    "start": "npm run clean && npm run build:js && npm run build:types && npm run build:css && npm run dev",
    "build": "npm run clean && npm run build:js && npm run build:types && npm run build:css",
    "build:js": "node build/build.js",
    "build:types": "tsc --emitDeclarationOnly",
    "build:css": "node build/build-css.js",
    "watch": "node build/watch.js",
    "clean": "node build/clean.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:all": "vitest run && playwright test",
    "typecheck": "tsc --noEmit",
    "types": "tsc --emitDeclarationOnly"
  },
  "keywords": [
    "video",
    "player",
    "audio",
    "accessible",
    "wcag",
    "wcag22",
    "a11y",
    "html5",
    "youtube",
    "vimeo",
    "soundcloud",
    "hls",
    "dash",
    "mpeg-dash",
    "transcript",
    "captions",
    "subtitles",
    "vanilla",
    "esm",
    "javascript",
    "typescript"
  ],
  "author": "Matthias Peltzer",
  "license": "GPL-2.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MatthiasPeltzer/vidply.git"
  },
  "bugs": {
    "url": "https://github.com/MatthiasPeltzer/vidply/issues",
    "email": "vidply@mpeltzer.de"
  },
  "homepage": "https://matthiaspeltzer.github.io/vidply/",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@vitest/coverage-v8": "^4.1.4",
    "clean-css": "^5.3.3",
    "esbuild": "^0.28.0",
    "jsdom": "^29.0.2",
    "terser": "^5.46.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  }
}
