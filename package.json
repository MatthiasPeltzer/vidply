{
  "name": "vidply",
  "version": "1.2.3",
  "description": "Universal, accessible video & audio player authored in strict TypeScript. Ships ES modules with type declarations, supports HTML5, YouTube, Vimeo, SoundCloud, HLS (hls.js + native iOS) and MPEG-DASH.",
  "type": "module",
  "main": "dist/prod/vidply.esm.min.js",
  "module": "dist/prod/vidply.esm.min.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "serve . -p 3000",
    "start": "npm run clean && npm run build:js && npm run build:types && npm run build:css && npm run dev",
    "build": "npm run clean && npm run build:js && npm run build:types && npm run build:css",
    "build:js": "node build/build.js",
    "build:types": "tsc -p tsconfig.build.json",
    "build:css": "node build/build-css.js",
    "watch": "node build/watch.js",
    "clean": "node build/clean.js",
    "lint": "eslint \"src/**/*.{ts,js}\" \"tests/**/*.{ts,js,mjs}\"",
    "lint:fix": "eslint --fix \"src/**/*.{ts,js}\" \"tests/**/*.{ts,js,mjs}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:all": "vitest run && playwright test",
    "typecheck": "tsc --noEmit",
    "types": "tsc -p tsconfig.build.json",
    "verify": "npm run typecheck && npm run lint && npm run test && node tests/check-readme-types.mjs",
    "prepublishOnly": "npm run clean && npm run build && npm run test:all"
  },
  "keywords": [
    "video",
    "player",
    "audio",
    "accessible",
    "wcag",
    "wcag22",
    "a11y",
    "html5",
    "youtube",
    "vimeo",
    "soundcloud",
    "hls",
    "dash",
    "mpeg-dash",
    "transcript",
    "captions",
    "subtitles",
    "vanilla",
    "esm",
    "javascript",
    "typescript"
  ],
  "author": "Matthias Peltzer",
  "license": "GPL-2.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MatthiasPeltzer/vidply.git"
  },
  "bugs": {
    "url": "https://github.com/MatthiasPeltzer/vidply/issues",
    "email": "vidply@mpeltzer.de"
  },
  "homepage": "https://matthiaspeltzer.github.io/vidply/",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^4.1.10",
    "clean-css": "^5.3.3",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "serve": "14.2.6",
    "terser": "^5.49.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
